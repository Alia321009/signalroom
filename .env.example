# Copy to .env and fill in. Never commit .env.

DATABASE_URL=sqlite:///./signalroom.db

# Generate distinct random values for each, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# The one admin/trader account -- bootstrapped from these on first
# startup (only if no admin exists yet). Its TOTP enrollment URI is
# logged once at that point; add it to an authenticator app immediately.
ADMIN_EMAIL=
ADMIN_PASSWORD=

TOTP_VALID_WINDOW=1
INACTIVITY_REVOKE_DAYS=14

LOG_LEVEL=INFO
ENVIRONMENT=development
